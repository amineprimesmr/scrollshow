AUTH_SECRET=
BACKUP_ENCRYPTION_KEY=
# Only enable after staging acceptance and an actual mediation agreement.
SALES_ENABLED=0
CONSUMER_MEDIATOR_NAME=
CONSUMER_MEDIATOR_ADDRESS=
CONSUMER_MEDIATOR_URL=
ALLOW_PREVIEW_PUBLISH=0
DATABASE_URL=
# Production requires a migrated PostgreSQL database. Local dev uses .data by default.
# Import a backup: npm run db:migrate -- /absolute/path/backup.json
BLOB_READ_WRITE_TOKEN=
STAGING_READ_WRITE_TOKEN=
SCROLLSHOW_API_KEY=
NEXT_PUBLIC_SITE_URL=https://scrollshow.io
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://scrollshow.io/tiktok/callback
TIKTOK_SANDBOX=
# Instagram + Facebook (Facebook Login). Redirect: {SITE}/api/auth/meta/callback
META_APP_ID=
META_APP_SECRET=
# X OAuth 2.0. Redirect: {SITE}/api/auth/x/callback
X_CLIENT_ID=
X_CLIENT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_CREATOR_MONTHLY=
STRIPE_PRICE_CREATOR_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_YEARLY=
STRIPE_PRICE_LIFETIME=
# Monthly price must be EUR 29.00/month; yearly EUR 199.00/year; lifetime EUR 99.00 one-time.
# RevenueCat — public API key of the project's Stripe app (Project > API keys >
# SDK API keys, the Stripe row). Not a v2 secret key. Unset = integration off,
# Stripe billing keeps working. Every ScrollShow purchase is declared once to
# RevenueCat, which then follows it on its own.
REVENUECAT_STRIPE_PUBLIC_KEY=
BRAVE_SEARCH_API_KEY=
# Only set after confirming the provider license permits the persistent library.
BRAVE_SEARCH_LIBRARY_LICENSE_CONFIRMED=0
# Explicit grandfathering: old subscriptions keep their price, new checkout does not use these IDs.
STRIPE_LEGACY_MONTHLY_PRICE_IDS=
METRICS_API_KEY=
METRICS_API_BASE=
# "direct" = appeler la source sans intermediaire (GET synchrone, ~33 % moins cher).
# Vide = mode par defaut (intermediaire, run asynchrone).
METRICS_API_MODE=
# Appels payants max par jour : abonne mensuel (120), annuel (80), a vie (40) ; par mois (1500) ; au total (1000).
METRICS_USER_DAILY_LIMIT=
METRICS_YEARLY_DAILY_LIMIT=
METRICS_LIFETIME_DAILY_LIMIT=
METRICS_USER_MONTHLY_LIMIT=
METRICS_PROVIDER_DAILY_LIMIT=
# Un email d'alerte par jour quand les appels payants depassent ce seuil (defaut 500), a OPS_ALERT_EMAIL (sinon EMAIL_FROM).
METRICS_ALERT_DAILY_CALLS=
OPS_ALERT_EMAIL=
# GitHub OAuth App — callback https://<domaine>/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
STRIPE_PRICE_PRO_YEARLY=
# Vercel AI Gateway — used to reconstruct imported TikToks into editable layers.
# Production uses OIDC automatically. Locally, create a key at Vercel → AI Gateway.
AI_GATEWAY_API_KEY=
# Protects /api/cron/publish (Vercel sends it as a Bearer token).
CRON_SECRET=
# Web Push (scheduled-publish notifications). Generate with `npx web-push generate-vapid-keys`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Maximum combined research search/profile provider calls per day across workspaces.
RESEARCH_PROVIDER_DAILY_LIMIT=1000
# Local browser companion only; never expose this token in the browser or commit it.
SCROLLSHOW_COLLECTOR_TOKEN=
